type mediaDescriptorType enum {
    type u8
}

type fat12And16ExtendedRecord struct {
    size = 512-2-36
    
    driveNumber u8
    ntFlags u8
    signature u8
    volumeId u32_le
    volumeLabel [11]char
    systemIdentifier [8]char
    bootCode [448]u8
}

type fat32ExtendedRecord struct {
    size = 512-2-36

    tableSize32 u32_le
    flags u16_le
    version u16_le
    rootDirectoryCluster u32_le
    fsInfoSector u16_le
    backupBoot u16_le
    _ [12]u8
    driveNumber u8
    ntFlags u8
    signature u8
    volumeId u32_le
    volumeLabel [11]char
    systemIdentifier [8]char
    bootCode [420]u8
}

type extendedBootRecord union {
    raw [512-2-36]u8
    fat12And16 fat12And16ExtendedRecord
    fat32 fat32ExtendedRecord
}

type BiosParameterBlock struct {
    size = 512

    jmp [3]u8
    oemIdentifier [8]char
    bytesPerSector u16_le
    sectorsPerCluster u8
    reservedSectors u16_le
    tableCount u8
    rootDirectoryEntries u16_le
    totalSectors16 u16_le
    mediaDescriptorType mediaDescriptorType
    tableSize16 u16_le
    sectorsPerTrack u16_le
    mediaHeads u16_le
    hiddenSectors u32_le
    totalSectors32 u32_le

    extendedBootRecord extendedBootRecord

    signature u16_le
}