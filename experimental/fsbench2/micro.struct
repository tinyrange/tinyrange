type microTest struct {
    a     u32_le
    bSize u16_le
}

type rawArchiveEntryHeader struct {
    entrySize u16_le
    version   u16_le
    totalSize u16_le
}

type rawArchiveEntry struct {
    contentsOffset u64_le
    kind           u8
    nameLen        u16_le
    linknameLen    u16_le
    contentSize    u64_le
    mode           u64_le
    uid            u32_le
    gid            u32_le
    modTime        u64_le
    devmajor       u64_le
    devminor       u64_le
}